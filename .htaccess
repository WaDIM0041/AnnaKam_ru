Options -Indexes
AddDefaultCharset UTF-8

# Pretty URLs for /admin -> /admin/index.html (Next.js static export)
DirectoryIndex index.html

# Custom error pages
ErrorDocument 404 /404.html

# Force HTTPS + non-www
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header to PHP (admin API Bearer auth; CGI/FPM strips it otherwise)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # HTTP -> HTTPS (учитываем, что за сайтом может быть прокси nginx)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$
    RewriteRule ^(.*)$ https://annakam.ru%{REQUEST_URI} [R=301,L]

    # www -> без www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://annakam.ru%{REQUEST_URI} [R=301,L]

    # Redirect only explicitly requested file aliases, not DirectoryIndex subrequests.
    RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
    RewriteRule ^index\.html$ https://annakam.ru/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+(privacy|terms-of-use)/index\.html[?\s] [NC]
    RewriteRule ^(privacy|terms-of-use)/index\.html$ https://annakam.ru/$1/ [R=301,L]
    RewriteRule ^(privacy|terms-of-use)\.html$ https://annakam.ru/$1/ [R=301,L]
    RewriteRule ^(privacy|terms-of-use)$ https://annakam.ru/$1/ [R=301,L]
</IfModule>

# Block direct access to internal files/dirs
<IfModule mod_rewrite.c>
    RewriteRule "^(data|_source|INSTALL|_local_old_backup|Удаленые файлы)(/|$)" - [F,L,NC]
    # Preserve ACME certificate renewal; deny other hidden paths.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    # Root instructions are not public content. Keep Next.js route payloads readable.
    RewriteRule "^(?!(?:robots|index|__next(?:\.[A-Za-z0-9_]+)?)\.txt$)[^/]+\.txt$" - [F,L,NC]
</IfModule>
<FilesMatch "(?i)(?:\.(sql|db|db-wal|db-shm|sqlite|sqlite3|log|bak|backup|old|env|ini|ps1|py|md|swp|swo|zip|7z|tar|gz)|~)$">
    Require all denied
</FilesMatch>

# Baseline protection compatible with existing inline Next.js scripts.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Enable .webp and other static types
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/manifest+json .webmanifest
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Brotli compression (preferred by modern browsers, if module present)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# BEGIN GENERATED SCRIPT CSP
